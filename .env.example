# ── Model (required) ────────────────────────────────────────────────────────
# Which provider to call. One of: openai | anthropic | google | openai-compatible
# Optional: inferred from which API key below is set (openai-compatible needs VALUZ_GENUI_BASE_URL + VALUZ_GENUI_API_KEY).
VALUZ_GENUI_PROVIDER=openai

# Model id for that provider — REQUIRED (no default is assumed).
#   openai:             gpt-5 / gpt-4.1 / o4-mini …
#   anthropic:          claude-sonnet-4-5 / claude-opus-4-1 …
#   google:             gemini-2.5-pro / gemini-2.5-flash …
#   openai-compatible:  whatever your endpoint serves (deepseek-chat, qwen-plus, a local vLLM model …)
VALUZ_GENUI_MODEL=gpt-5

# API key. Either the generic VALUZ_GENUI_API_KEY, or the provider's own variable:
#   OPENAI_API_KEY / ANTHROPIC_API_KEY / GOOGLE_GENERATIVE_AI_API_KEY
VALUZ_GENUI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Custom endpoint (optional for openai/anthropic/google; REQUIRED for openai-compatible).
# Examples: https://api.deepseek.com/v1  ·  https://dashscope.aliyuncs.com/compatible-mode/v1  ·  http://127.0.0.1:11434/v1
# VALUZ_GENUI_BASE_URL=

# OpenAI only: which API surface. responses (default) | chat
# VALUZ_GENUI_OPENAI_API=responses

# ── Generation defaults (optional) ──────────────────────────────────────────
# VALUZ_GENUI_MAX_OUTPUT_TOKENS=16384     # per model turn (thinking models: covers reasoning + answer)
# VALUZ_GENUI_MAX_CONTINUATIONS=3         # follow-up turns when the output is cut at the token cap
# VALUZ_GENUI_MAX_ATTEMPTS=2              # whole-generation retries on blank/unusable output
# VALUZ_GENUI_TEMPERATURE=                # unset = provider default (thinking models ignore it)
# Reasoning / thinking effort: none | minimal | low | medium | high | xhigh | max (unset = provider default).
# Mapped to each provider (OpenAI reasoning.effort, Anthropic thinking + output_config.effort,
# openai-compatible reasoning_effort; `none` also sends DeepSeek's thinking:{type:"disabled"}).
# VALUZ_GENUI_REASONING_EFFORT=

# DeepSeek thinking models (deepseek-v4-flash / -pro): reasoning is shown in the playground on every route.
#   openai-compatible + VALUZ_GENUI_BASE_URL=https://api.deepseek.com   ← recommended: native reasoning parts, `none` works
#   anthropic         + VALUZ_GENUI_BASE_URL=https://api.deepseek.com/anthropic
#   openai (Responses)+ VALUZ_GENUI_BASE_URL=https://api.deepseek.com   ← works; reasoning is recovered from raw chunks,
#                                                                    but VALUZ_GENUI_REASONING_EFFORT=none is not honoured there

# ── Server (optional) ───────────────────────────────────────────────────────
# VALUZ_GENUI_HOST=127.0.0.1
# VALUZ_GENUI_PORT=8787
# VALUZ_GENUI_CORS_ORIGIN=*
# VALUZ_GENUI_MCP=1                       # 0 disables the /mcp endpoint

# ── Playground (optional) ───────────────────────────────────────────────────
# Where the Vite dev proxy forwards /api (default http://127.0.0.1:8787)
# VALUZ_GENUI_SERVER_URL=http://127.0.0.1:8787
# Or point the built playground straight at a server instead of the proxy:
# VITE_VALUZ_GENUI_SERVER=http://127.0.0.1:8787
