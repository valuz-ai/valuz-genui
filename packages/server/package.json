{
  "name": "@valuz/server",
  "private": true,
  "version": "0.1.0",
  "description": "generate_ui HTTP + MCP server (Hono, Vercel AI SDK)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "test": "cd ../.. && vitest run --config vitest.config.ts packages/server/src",
    "probe": "tsx scripts/probe.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/openai": "^4.0.42",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@valuz/a2ui": "workspace:*",
    "@valuz/genui": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.66",
    "hono": "^4.13.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
