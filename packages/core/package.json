{
  "name": "@valuz/genui-core",
  "version": "0.1.0",
  "description": "generate_ui engine: prompt assembly, model streaming loop, A2UI document extraction and validation",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/add-js-extensions.mjs dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "test": "cd ../.. && vitest run --config vitest.config.ts packages/core/src",
    "prepublishOnly": "tsc -p tsconfig.build.json && node ../../scripts/add-js-extensions.mjs dist"
  },
  "dependencies": {
    "@valuz/a2ui": "workspace:*",
    "zod": "^3.25.76"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valuz-ai/valuz-genui.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist"
  ]
}
